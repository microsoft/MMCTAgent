# ─────────────────────────────────────────────────────────────
# LLM Provider — Chat & Reasoning (e.g. OpenAI, Anthropic, Gemini)
# ─────────────────────────────────────────────────────────────
# If LLM_API_KEY is empty, system falls back to Managed Identity
LLM_ENDPOINT=https://<your-resource-name>.openai.azure.com/
LLM_API_KEY=
LLM_DEPLOYMENT_NAME=<e.g. gpt-4o>
LLM_MODEL_NAME=<e.g. gpt-4o-2024-05-13>
LLM_API_VERSION=2024-12-01-preview

# ─────────────────────────────────────────────────────────────
# 3. Transcription & Speech Services
# ─────────────────────────────────────────────────────────────
# Select your primary provider for video transcription.
# Choose: 'azure' (Speech Service) or 'whisper' (Azure OpenAI Whisper).
TRANSCRIPTION_PROVIDER=azure

# --- Provider A: Azure OpenAI Whisper ---
# Reuses LLM_ENDPOINT and LLM_API_VERSION. 
# Uses TRANSCRIPTION_API_KEY (falls back to identity if empty).
WHISPER_DEPLOYMENT_NAME=<e.g. whisper>
TRANSCRIPTION_API_KEY=

# --- Provider B: Azure Speech Service (Cognitive Services) ---
# Used for real-time transcription and conversation STT.
# If SPEECH_SERVICE_API_KEY is empty, falls back to Managed Identity.
SPEECH_SERVICE_REGION=eastus
SPEECH_SERVICE_API_KEY=
SPEECH_SERVICE_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<resource-name>

# ─────────────────────────────────────────────────────────────
# 4. Storage Service — Video & Media Assets (Azure Blob Storage)
# ─────────────────────────────────────────────────────────────
# STORAGE_ACCESS_KEY can be a Connection String or Account Key.
# If empty, system falls back to Managed Identity.
STORAGE_ACCOUNT_NAME=<your-storage-account-name>
STORAGE_ACCESS_KEY=
KEYFRAME_CONTAINER_NAME=keyframe-container

# ─────────────────────────────────────────────────────────────
# 5. Graph Database (Neo4j)
# ─────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ─────────────────────────────────────────────────────────────
# Access Control (ACL) — post-filter access checks
# ─────────────────────────────────────────────────────────────
# Gates ACL filtering on both query pipelines (graph_agent and graph_state).
# When true, callers must supply an acl_callback at VideoQueryPipeline
# construction and a user_identifier_context dict on every pipeline.query()
# invocation; tool outputs are then filtered down to videos the caller is
# permitted to see.
#
# WARNING: user_identifier_context commonly carries bearer secrets (e.g.
# graph_token). Never log it, repr it, or echo it back in error messages.
ACL_ENABLED=false
