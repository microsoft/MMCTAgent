# ─────────────────────────────────────────────────────────────
# LLM Provider — Chat & Reasoning (e.g. OpenAI, Anthropic, Gemini)
# ─────────────────────────────────────────────────────────────
LLM_ENDPOINT=https://api.example.com/v1/
LLM_API_KEY=<your-api-key>
LLM_DEPLOYMENT_NAME=<your-llm-deployment-name>
LLM_MODEL_NAME=<e.g. gpt-4o>
LLM_API_VERSION=2024-12-01-preview

# ─────────────────────────────────────────────────────────────
# Transcription Provider — Whisper / Speech-to-Text
# ─────────────────────────────────────────────────────────────
TRANSCRIPTION_PROVIDER=azure # Choose: azure (Speech Service), whisper (Azure OpenAI)
TRANSCRIPTION_API_KEY=<your-transcription-api-key>
WHISPER_DEPLOYMENT_NAME=<your-whisper-deployment-name>

# ─────────────────────────────────────────────────────────────
# Embedding Service — Vector Search 
# ─────────────────────────────────────────────────────────────
EMBEDDING_SERVICE_ENDPOINT=https://api.example.com/v1/
EMBEDDING_SERVICE_API_KEY=<your-embedding-api-key>
EMBEDDING_SERVICE_DEPLOYMENT_NAME=<e.g. text-embedding-ada-002>
EMBEDDING_SERVICE_API_VERSION=2024-08-01-preview

# ─────────────────────────────────────────────────────────────
# Storage — Video & Media (e.g. S3, Blob Storage)
# ─────────────────────────────────────────────────────────────
STORAGE_ACCOUNT_NAME=<your-storage-account-name>
STORAGE_ACCESS_KEY=<your-storage-access-key>
KEYFRAME_CONTAINER_NAME=keyframe-container-name

# ─────────────────────────────────────────────────────────────
# Speech Service — Real-time Transcription
# ─────────────────────────────────────────────────────────────
SPEECH_SERVICE_API_KEY=<your-speech-api-key>
SPEECH_SERVICE_REGION=<e.g. eastus>

# ─────────────────────────────────────────────────────────────
# Graph Database (Neo4j) — leave password empty to disable
# ─────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

