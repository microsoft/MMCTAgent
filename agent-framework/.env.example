# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional: Additional deployments for multi-model support
# AZURE_OPENAI_DEPLOYMENTS={"fast": "gpt-35-turbo", "smart": "gpt-4"}

# Logging Configuration
MMCT_LOG_LEVEL=INFO
MMCT_LOG_FORMAT=json
MMCT_LOG_OUTPUT=stderr

# Memory Configuration
MMCT_MEMORY_DEFAULT_STRATEGY=adaptive
MMCT_MEMORY_MAX_TOKENS=4000
MMCT_MEMORY_WINDOW_SIZE=20

# Swarm Configuration
MMCT_SWARM_MAX_ITERATIONS=20
MMCT_SWARM_TIMEOUT_SECONDS=300
MMCT_SWARM_PERSIST_MEMORY=false
