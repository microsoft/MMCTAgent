# MMCT Agent Environment Configuration
# Copy this file to .env and fill in your values.

# Application Settings
APP_NAME=MMCT Agent
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# LLM Provider Configuration (Azure OpenAI)
LLM_PROVIDER=azure
LLM_USE_MANAGED_IDENTITY=true
LLM_TIMEOUT=200
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
LLM_ENDPOINT=https://<your-azure-openai-resource>.openai.azure.com/
LLM_DEPLOYMENT_NAME=gpt-4o
LLM_MODEL_NAME=gpt-4o
LLM_API_VERSION=2025-01-01-preview

# Embedding Provider Configuration
EMBEDDING_PROVIDER=azure
EMBEDDING_USE_MANAGED_IDENTITY=true
EMBEDDING_TIMEOUT=200
EMBEDDING_SERVICE_ENDPOINT=https://<your-azure-openai-resource>.openai.azure.com/
EMBEDDING_SERVICE_DEPLOYMENT_NAME=text-embedding-ada-002
EMBEDDING_SERVICE_API_VERSION=2024-12-01-preview
EMBEDDING_SERVICE_MODEL_NAME=text-embedding-ada-002

# Azure AI Search Configuration
SEARCH_PROVIDER=azure_ai_search
SEARCH_USE_MANAGED_IDENTITY=true
SEARCH_TIMEOUT=30
SEARCH_ENDPOINT=https://<your-search-resource>.search.windows.net

# Vector Database Index Names
CHAPTER_INDEX_NAME=mmct-chapter-index
KEYFRAMES_INDEX_NAME=mmct-keyframes-index
OBJECT_COLLECTION_INDEX_NAME=mmct-object-registry

# Temporal Graph Index Names (v5 pipeline)
SYNOPSIS_INDEX_NAME=synopsis-index
TEMPORAL_EVENTS_INDEX_NAME=temporal-events-index

# Transcription Provider Configuration (Azure Speech Service)
TRANSCRIPTION_PROVIDER=azure
SPEECH_USE_MANAGED_IDENTITY=true
SPEECH_TIMEOUT=200
SPEECH_SERVICE_REGION=<your-region>
SPEECH_SERVICE_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<speech-resource>

# Storage Configuration (Azure Blob Storage)
STORAGE_PROVIDER=azure
STORAGE_USE_MANAGED_IDENTITY=true
STORAGE_ACCOUNT_NAME=<your-storage-account>
STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net/
BLOB_MANAGED_IDENTITY=true

# Storage Container Configuration
VIDEO_CONTAINER_NAME=mmct-videocontainer
FRAMES_CONTAINER_NAME=mmct-framescontainer
TIMESTAMPS_CONTAINER_NAME=mmct-timestampscontainer
TRANSCRIPT_CONTAINER_NAME=mmct-transcriptcontainer
AUDIO_CONTAINER_NAME=mmct-audiocontainer
VIDEO_DESCRIPTION_CONTAINER_NAME=mmct-summary-n-transcript
KEYFRAME_CONTAINER_NAME=mmct-keyframes
BLOB_DOWNLOAD_DIR=media

# Event Hub Configuration (for queue-based ingestion)
INGESTION_EVENT_HUB_NAME=<your-event-hub-name>
EVENT_HUB_NAMESPACE=<your-event-hub-namespace>

# Neo4j Graph Database (v5 pipeline)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j

# LLM Rate Limiting (v5 pipeline)
LLM_RATE_LIMIT_RPM=60
LLM_RATE_LIMIT_TPM=100000
LLM_MAX_CONTEXT_TOKENS=128000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_SUPPORTS_VISION=true
LLM_SUPPORTS_JSON_MODE=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/mmct-app.log
LOG_ENABLE_JSON=false
LOG_ENABLE_FILE=true
LOG_MAX_FILE_SIZE=10 MB
LOG_RETENTION_DAYS=7

# Security Configuration
MANAGED_IDENTITY=true
ENABLE_SECRETS_MANAGER=false
