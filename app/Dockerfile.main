# Main application Dockerfile
ARG BASE_IMAGE=mmct-base:latest
FROM ${BASE_IMAGE}

WORKDIR /app

# Copy application-specific files
COPY app/ app/


# Copy core package and available directories
COPY mmct/ mmct/
COPY config/ config/
COPY docs/ docs/
COPY mcp_server/ mcp_server/

RUN pip install -e .

# Auto-bump minor version: read current version, increment minor, write back
RUN CURRENT=$(grep '_DEFAULT_VERSION' app/version.py | head -1 | grep -oP '\d+\.\d+\.\d+') && \
    MAJOR=$(echo "$CURRENT" | cut -d. -f1) && \
    MINOR=$(echo "$CURRENT" | cut -d. -f2) && \
    PATCH=$(echo "$CURRENT" | cut -d. -f3) && \
    NEW_MINOR=$((MINOR + 1)) && \
    NEW_VERSION="${MAJOR}.${NEW_MINOR}.0" && \
    sed -i "s/_DEFAULT_VERSION = \"${CURRENT}\"/_DEFAULT_VERSION = \"${NEW_VERSION}\"/" app/version.py && \
    echo "Version bumped: ${CURRENT} → ${NEW_VERSION}"

# Stamp build timestamp into the version file
RUN BUILD_TS=$(date -u '+%Y-%m-%d %H:%M:%S UTC') && \
    sed -i "s/_DEFAULT_BUILD_TIMESTAMP = \"\"/_DEFAULT_BUILD_TIMESTAMP = \"${BUILD_TS}\"/" app/version.py && \
    echo "Build timestamp: ${BUILD_TS}"

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app:/app/app

# Create non-root user for security (ensure home directory is created)
RUN groupadd -r appuser && useradd -r -g appuser -m -d /home/appuser appuser
RUN chown -R appuser:appuser /app /app/media /app/logs

# Set HOME explicitly to ensure cache directories work correctly
ENV HOME=/home/appuser
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/docs || exit 1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]