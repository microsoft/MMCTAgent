# Main application Dockerfile
ARG BASE_IMAGE=mmct-base:latest
FROM ${BASE_IMAGE}

WORKDIR /app

# Copy application-specific files
COPY app/ app/

# Overlay updated mmct package files (overrides base image)
COPY mmct/ mmct/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app:/app/app

# Create non-root user for security (ensure home directory is created)
RUN groupadd -r appuser && useradd -r -g appuser -m -d /home/appuser appuser
RUN chown -R appuser:appuser /app /app/media /app/logs

# Set HOME explicitly to ensure cache directories work correctly
ENV HOME=/home/appuser
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/docs || exit 1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]