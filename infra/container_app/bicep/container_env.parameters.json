{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "environmentName": {
      "value": "mmct-env"
    },
    "logAnalyticsWorkspaceName": {
      "value": "mmct-logs"
    },
    "vnetName": {
      "value": "mmct-vnet"
    },
    "subnetName": {
      "value": "mmct-subnet-apps"
    },
    "vnetAddressPrefix": {
      "value": "10.0.0.0/16"
    },
    "subnetAddressPrefix": {
      "value": "10.0.0.0/23"
    },
    "natGatewayName": {
      "value": "mmct-natgw"
    },
    "natGatewayPipName": {
      "value": "mmct-natgw-pip"
    }
  }
}